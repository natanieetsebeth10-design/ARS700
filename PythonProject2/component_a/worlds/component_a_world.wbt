#VRML_SIM R2025a utf8

# Load the background, lighting, floor, and e-puck robot.
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

# COMPONENT A: WORLD
# This is the environment where the robot moves and detects obstacles.
# The camera detects objects, while the 8 IR sensors detect nearby obstacles.
# We use IR sensors instead of LiDAR because they are already built into the robot.

# Set the simulation settings.
WorldInfo {
  info [
    "Component A: Perception, Motion Planning and Control"
  ]
  title "Component A - Mobile Robot Navigation"
  basicTimeStep 16
}

# Set the camera view so we can see the robot and the environment.
Viewpoint {
  orientation -0.577 0.577 0.577 2.094
  position 0 0 4.5
}

# Add the background and lighting.
TexturedBackground {
}
TexturedBackgroundLight {
}

# Create a square arena with a floor and walls.
RectangleArena {
  translation 0 0 0
  floorSize 3 3
  floorTileSize 0.5 0.5
  wallHeight 0.3
}

# Obstacle 1: A small red box.
# The robot must detect and avoid it.
Solid {
  translation 0.5 0.3 0.05
  name "obstacle_1"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.2 0.2
      }
      geometry Box {
        size 0.2 0.2 0.1
      }
    }
  ]
  boundingObject Box {
    size 0.2 0.2 0.1
  }
}

# Obstacle 2: A green cylinder.
Solid {
  translation -0.4 0.6 0.05
  name "obstacle_2"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.6 0.2
      }
      geometry Cylinder {
        height 0.1
        radius 0.12
      }
    }
  ]
  boundingObject Cylinder {
    height 0.1
    radius 0.12
  }
}

# Obstacle 3: A long blue box.
Solid {
  translation 0.2 -0.5 0.05
  name "obstacle_3"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.2 0.8
      }
      geometry Box {
        size 0.15 0.4 0.1
      }
    }
  ]
  boundingObject Box {
    size 0.15 0.4 0.1
  }
}

# Obstacle 4: A yellow box.
Solid {
  translation -0.7 -0.3 0.05
  name "obstacle_4"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.7 0.1
      }
      geometry Box {
        size 0.3 0.15 0.1
      }
    }
  ]
  boundingObject Box {
    size 0.3 0.15 0.1
  }
}

# Add the e-puck robot to the arena.
# Set its starting position, direction, and controller.
# The camera resolution is set to 128 by 128 pixels.
E-puck {
  translation -1.0 -1.0 0
  rotation 0 0 1 0.78
  name "epuck"
  controller "epuck_perception"
  camera_width 128
  camera_height 128
}